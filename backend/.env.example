# Password-reset email configuration.
# Use an SMTP provider that supports STARTTLS (default) or implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@example.com
SMTP_USE_SSL=false

# Public frontend URL for the React /reset-password route.
# Use the deployed frontend origin over HTTPS outside local development.
# The backend appends the reset token in the URL fragment.
PASSWORD_RESET_URL=http://127.0.0.1:5173/reset-password